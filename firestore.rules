rules_version = '2';

// ============================================================
// SHAKTRIX FIRESTORE SECURITY RULES
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Confirms the Auth token carries email_verified = true.
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // SECURITY SOURCE OF TRUTH for admin role.
    function isAdminEmail() {
      return isAuthenticated() && request.auth.token.email in [
        'asthaojas30@gmail.com',
        'vk844504@gmail.com'
      ];
    }

    // ----------------------------------------------------------
    // /gamertags/{gamertag}
    // ----------------------------------------------------------
    match /gamertags/{gamertag} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ----------------------------------------------------------
    // /profiles/{userId}
    // ----------------------------------------------------------
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;

      // -- Notifications subcollection --
      match /notifications/{notificationId} {
        allow read, update: if isAuthenticated() && request.auth.uid == userId;

        allow create: if isAuthenticated() && (
          // Owner can write their own notifications
          request.auth.uid == userId

          // Team captains / members sending notifications
          || request.resource.data.type == 'team_invite'
          || request.resource.data.type == 'captain_transferred'
          || request.resource.data.type == 'captain_updated'
          || request.resource.data.type == 'registration_confirmed'

          // Tournament notifications
          || request.resource.data.type == 'tournament_starting'
          || request.resource.data.type == 'match_result'

          // Admin notifications
          || (request.resource.data.type == 'new_tournament' && isAdminEmail())
        );

        allow delete: if false;
      }
    }

    // ----------------------------------------------------------
    // /teams/{teamId}
    // ----------------------------------------------------------
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isEmailVerified();
      allow update: if isAuthenticated() && (
        // Case 1: Captain can update the team (invite, edit, disband)
        resource.data.captainId == request.auth.uid
        // Case 2: Invited player accepts the invite and adds their own UID to members
        || (
          isEmailVerified()
          && request.resource.data.captainId == resource.data.captainId
          && request.resource.data.name == resource.data.name
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
        )
        // Case 3: Non-captain member leaves the team voluntarily
        || (
          request.resource.data.captainId == resource.data.captainId
          && request.resource.data.name == resource.data.name
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
        )
      );
      allow delete: if isAuthenticated()
                    && resource.data.captainId == request.auth.uid;
    }

    // ----------------------------------------------------------
    // /tournaments/{tournamentId}
    // ----------------------------------------------------------
    match /tournaments/{tournamentId} {
      allow read: if true;

      // Only verified admin emails can create tournaments.
      allow create: if isAdminEmail() && isEmailVerified();

      // Organizer, Admin, or registering Captain / Participant status sync
      allow update: if isAuthenticated() && (
        // Case 1: Organizer or Admin updates the tournament
        resource.data.organizerId == request.auth.uid
        || isAdminEmail()
        // Case 2: Team captain registers their team for an upcoming tournament
        || (
          resource.data.status == 'Upcoming'
          && request.resource.data.organizerId == resource.data.organizerId
          && request.resource.data.name == resource.data.name
          && request.resource.data.registeredTeamIds.hasAll(resource.data.registeredTeamIds)
          && request.resource.data.registeredTeamIds.size() == resource.data.registeredTeamIds.size() + 1
          && request.resource.data.lastRegisteredTeamId in request.resource.data.registeredTeamIds
          && get(/databases/$(database)/documents/teams/$(request.resource.data.lastRegisteredTeamId)).data.captainId == request.auth.uid
        )
        // Case 3: Participant auto-updating bracket state / match auto-resolution
        || (
          request.resource.data.organizerId == resource.data.organizerId
          && request.resource.data.name == resource.data.name
        )
      );

      allow delete: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid || isAdminEmail()
      );

      // Matches subcollection (/tournaments/{tournamentId}/matches/{matchId})
      match /matches/{matchId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if isAdminEmail() || (isAuthenticated() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid);
      }

      // Tournament live chat subcollection (/tournaments/{tournamentId}/messages/{messageId})
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isEmailVerified()
                      && (request.resource.data.senderId == request.auth.uid || request.resource.data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if isAdminEmail() || (isAuthenticated() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid);
      }
    }

    // ----------------------------------------------------------
    // /matchHistory/{matchId}
    // ----------------------------------------------------------
    match /matchHistory/{matchId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ----------------------------------------------------------
    // /matchVods/{vodId}
    // ----------------------------------------------------------
    match /matchVods/{vodId} {
      allow read: if true;
      allow create: if isEmailVerified()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isEmailVerified()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // ----------------------------------------------------------
    // /globalChatMessages/{messageId}
    // ----------------------------------------------------------
    match /globalChatMessages/{messageId} {
      allow read: if true;
      allow create: if isEmailVerified()
                    && request.resource.data.senderId == request.auth.uid
                    && !(request.resource.data.text.matches('(?i).*https?://.*') || request.resource.data.text.matches('(?i).*www\\..*') || request.resource.data.text.matches('(?i).*data:image/.*base64.*'));
      allow update: if false;
      allow delete: if isAdminEmail();
    }

    // ----------------------------------------------------------
    // /chatReports/{reportId}
    // ----------------------------------------------------------
    match /chatReports/{reportId} {
      allow read, delete: if isAdminEmail();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update: if false;
    }

    // ----------------------------------------------------------
    // /mutedUsers/{userId}
    // ----------------------------------------------------------
    match /mutedUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdminEmail();
    }

    // ----------------------------------------------------------
    // /flaggedMessages/{flagId}
    // ----------------------------------------------------------
    match /flaggedMessages/{flagId} {
      allow read, delete: if isAdminEmail();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ----------------------------------------------------------
    // /tournamentRegistrations/{regId}
    // ----------------------------------------------------------
    match /tournamentRegistrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdminEmail();
    }

  }
}
